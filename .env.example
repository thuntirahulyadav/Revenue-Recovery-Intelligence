# ==========================================
# Razorpay Recovery Intelligence (RRI) - Env
# ==========================================

# Go Backend Server
PORT=8082
ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rri_db
POSTGRES_USER=rri_user
POSTGRES_PASSWORD=rri_secure_password
POSTGRES_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (Event-Driven Stream)
KAFKA_BROKERS=kafka:9092
KAFKA_ENABLED=true
KAFKA_GROUP_ID=rri-recovery-group

# Python ML Service
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_TIMEOUT_SECONDS=5

# Razorpay Test Mode Credentials (Optional / Simulated Mode)
RAZORPAY_KEY_ID=rzp_test_rri_recovery_sim
RAZORPAY_KEY_SECRET=rzp_secret_sim_mock_only

# Frontend Public API URL
VITE_API_BASE_URL=/api/v1
